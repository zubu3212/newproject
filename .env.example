PORT=8001
APP_URL=http://localhost:8001
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your-postgres-password
PGDATABASE=novatek

# Optional: register an existing account email as the store administrator.
ADMIN_EMAIL=

# Add provider credentials to your local .env file. Never commit that file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple requires an HTTPS callback on a domain registered with Apple.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

X_CLIENT_ID=
X_CLIENT_SECRET=
